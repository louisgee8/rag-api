# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets.

# --- API auth ---
# Single bearer token. Generate with: openssl rand -hex 32
API_KEY=replace-me-with-openssl-rand-hex-32

# --- Anthropic ---
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Postgres ---
# Inside docker-compose, host = "db" (the service name).
# For local dev outside docker, host = "localhost".
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=replace-me-strong-password

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Retrieval ---
TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Rate limiting (Phase 2 Step 2) ---
# Per-API-key fixed-window limiter. Counters live in-process (no Redis).
# Production-ish default: 60 requests per 60 seconds per key.
# Lower this in your local .env if you want a faster smoke test.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Relevance threshold (Phase 2 Step 5) ---
# Minimum cosine-distance gap between top-1 and top-2 retrieved chunks
# for /query/answer to proceed to LLM synthesis. If gap is below this
# value, the route short-circuits with HTTP 422 low_confidence and
# never calls Anthropic.
# Calibration (Phase 1): absent content gap ~0.01, smoke fixture 0.2039,
# strong real matches 0.55+. Default 0.05 blocks absent-content while
# letting moderate-and-strong matches through.
RELEVANCE_MIN_GAP=0.05
